<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Rent Your Room | Room On Rent</title>

    <!-- Tailwind compiled CSS -->
    <link rel="stylesheet" href="../css/output.css">
</head>

<body class="bg-slate-50 text-slate-900">

    <!-- ================= NAVBAR ================= -->

  <%- include("../partials/navbar.ejs") %>

    <!-- ================= PAGE HEADER ================= -->

    <section class="border-b border-slate-200 bg-white">

        <div class="mx-auto flex max-w-5xl items-center gap-4 px-4 py-8 sm:px-6 lg:px-8">

            <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-indigo-50 text-3xl">
                🏠
            </div>

            <div>

                <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
                    Rent Your Room
                </h1>

                <p class="mt-1 text-slate-600">
                    List your room and find the right tenant easily.
                </p>

            </div>

        </div>

    </section>


    <!-- ================= MAIN ================= -->

    <main class="mx-auto max-w-5xl px-4 py-8 sm:px-6 lg:px-8">


        <!-- ================= PROGRESS ================= -->

        <div class="mb-8 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">

            <div class="flex items-center">

                <!-- STEP 1 -->

                <div class="flex min-w-0 items-center gap-2">

                    <span
                        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-indigo-600 text-sm font-bold text-white">
                        1
                    </span>

                    <span class="hidden text-sm font-semibold text-indigo-600 sm:block">
                        Room Details
                    </span>

                </div>


                <div class="mx-3 h-px flex-1 bg-indigo-200"></div>


                <!-- STEP 2 -->

                <div class="flex min-w-0 items-center gap-2">

                    <span
                        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-200 text-sm font-semibold text-slate-600">
                        2
                    </span>

                    <span class="hidden text-sm font-medium text-slate-500 sm:block">
                        Photos
                    </span>

                </div>


                <div class="mx-3 h-px flex-1 bg-slate-200"></div>


                <!-- STEP 3 -->

                <div class="flex min-w-0 items-center gap-2">

                    <span
                        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-slate-200 text-sm font-semibold text-slate-600">
                        3
                    </span>

                    <span class="hidden text-sm font-medium text-slate-500 sm:block">
                        Review & Submit
                    </span>

                </div>

            </div>

        </div>


        <!-- ================= FORM ================= -->

        <form action="/rooms" method="POST" enctype="multipart/form-data">


            <!-- ================= BASIC INFORMATION ================= -->

            <section class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7">

                <div class="mb-7 flex items-start gap-4">

                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-xl">
                        📋
                    </div>

                    <div>

                        <h2 class="text-xl font-bold text-slate-900">
                            Basic Information
                        </h2>

                        <p class="mt-1 text-sm text-slate-500">
                            Tell tenants about your room.
                        </p>

                    </div>

                </div>


                <div class="grid grid-cols-1 gap-5 md:grid-cols-2">


                    <!-- ROOM TITLE -->

                    <div class="md:col-span-2">

                        <label for="title" class="mb-2 block text-sm font-semibold text-slate-700">

                            Room Title
                            <span class="text-red-500">*</span>

                        </label>

                        <input type="text" id="title" name="title" maxlength="100"
                            placeholder="e.g. Spacious Single Room in Kakadeo" required
                            class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">

                    </div>


                    <!-- ROOM TYPE -->

                    <div>

                        <label for="roomType" class="mb-2 block text-sm font-semibold text-slate-700">

                            Room Type
                            <span class="text-red-500">*</span>

                        </label>

                        <select id="roomType" name="roomType" required
                            class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">

                            <option value="" disabled selected>
                                Select Room Type
                            </option>

                            <option value="single">Single Room</option>
                            <option value="double">Double Room</option>
                            <option value="triple">Triple Sharing</option>
                            <option value="pg">PG</option>
                            <option value="1bhk">1 BHK</option>
                            <option value="2bhk">2 BHK</option>

                        </select>

                    </div>


                    <!-- FURNISHING -->

                    <div>

                        <label for="furnishing" class="mb-2 block text-sm font-semibold text-slate-700">

                            Furnishing
                            <span class="text-red-500">*</span>

                        </label>

                        <select id="furnishing" name="furnishing" required
                            class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">

                            <option value="" disabled selected>
                                Select Furnishing
                            </option>

                            <option value="fully-furnished">
                                Fully Furnished
                            </option>

                            <option value="semi-furnished">
                                Semi Furnished
                            </option>

                            <option value="unfurnished">
                                Unfurnished
                            </option>

                        </select>

                    </div>


                    <!-- LOCATION -->

                    <div>

                        <label for="location" class="mb-2 block text-sm font-semibold text-slate-700">

                            Location / Area
                            <span class="text-red-500">*</span>

                        </label>

                        <input type="text" id="location" name="location" placeholder="e.g. Kakadeo, Kanpur" required
                            class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">

                    </div>


                    <!-- CITY -->

                    <div>

                        <label for="city" class="mb-2 block text-sm font-semibold text-slate-700">

                            City
                            <span class="text-red-500">*</span>

                        </label>

                        <select id="city" name="city" required
                            class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">

                            <option value="" disabled selected>
                                Select City
                            </option>

                            <option value="kanpur">Kanpur</option>
                            <option value="lucknow">Lucknow</option>
                            <option value="prayagraj">Prayagraj</option>
                            <option value="varanasi">Varanasi</option>
                            <option value="delhi">Delhi</option>
                            <option value="agra">Agra</option>
                            <option value="other">Other</option>

                        </select>

                    </div>


                    <!-- LANDMARK -->

                    <div class="md:col-span-2">

                        <label for="landmark" class="mb-2 block text-sm font-semibold text-slate-700">

                            Nearby Landmark

                        </label>

                        <input type="text" id="landmark" name="landmark" placeholder="e.g. Near Allen Institute"
                            class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">

                        <p class="mt-2 text-xs text-slate-500">
                            Mention nearby coaching, college, metro station, market etc.
                        </p>

                    </div>


                    <!-- RENT -->

                    <div>

                        <label for="price" class="mb-2 block text-sm font-semibold text-slate-700">

                            Monthly Rent (₹)
                            <span class="text-red-500">*</span>

                        </label>

                        <div
                            class="flex overflow-hidden rounded-xl border border-slate-300 focus-within:border-indigo-500 focus-within:ring-4 focus-within:ring-indigo-100">

                            <span class="flex items-center bg-slate-50 px-4 font-semibold text-slate-600">
                                ₹
                            </span>

                            <input type="number" id="price" name="price" placeholder="5000" min="0" required
                                class="w-full px-4 py-3 text-sm outline-none">

                        </div>

                    </div>


                    <!-- SECURITY DEPOSIT -->

                    <div>

                        <label for="securityDeposit" class="mb-2 block text-sm font-semibold text-slate-700">

                            Security Deposit (₹)

                        </label>

                        <div
                            class="flex overflow-hidden rounded-xl border border-slate-300 focus-within:border-indigo-500 focus-within:ring-4 focus-within:ring-indigo-100">

                            <span class="flex items-center bg-slate-50 px-4 font-semibold text-slate-600">
                                ₹
                            </span>

                            <input type="number" id="securityDeposit" name="securityDeposit" placeholder="5000" min="0"
                                class="w-full px-4 py-3 text-sm outline-none">

                        </div>

                    </div>


                    <!-- AVAILABLE FROM -->

                    <div>

                        <label for="availableFrom" class="mb-2 block text-sm font-semibold text-slate-700">

                            Available From
                            <span class="text-red-500">*</span>

                        </label>

                        <input type="date" id="availableFrom" name="availableFrom" required
                            class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">

                    </div>


                    <!-- DESCRIPTION -->

                    <div class="md:col-span-2">

                        <div class="mb-2 flex items-center justify-between">

                            <label for="description" class="block text-sm font-semibold text-slate-700">

                                Room Description
                                <span class="text-red-500">*</span>

                            </label>

                            <span id="charCount" class="text-xs text-slate-400">
                                0/500
                            </span>

                        </div>

                        <textarea id="description" name="description" rows="6" maxlength="500" required
                            placeholder="Describe your room, facilities, environment..."
                            class="w-full resize-none rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100"></textarea>

                    </div>

                </div>

            </section>


            <!-- ================= PHOTOS ================= -->

            <section class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7">

                <div class="mb-7 flex items-start gap-4">

                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-xl">
                        📷
                    </div>

                    <div>

                        <h2 class="text-xl font-bold text-slate-900">
                            Upload Photos
                        </h2>

                        <p class="mt-1 text-sm text-slate-500">
                            Upload clear photos to get more tenants.
                        </p>

                    </div>

                </div>


                <!-- UPLOAD AREA -->

                <div id="uploadArea"
                    class="cursor-pointer rounded-2xl border-2 border-dashed border-indigo-200 bg-indigo-50/50 px-5 py-10 text-center transition hover:border-indigo-400 hover:bg-indigo-50">

                    <input type="file" id="photos" name="photos" accept="image/jpeg,image/png" multiple hidden>

                    <div
                        class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-white text-3xl shadow-sm">
                        ☁️
                    </div>

                    <h3 class="mt-5 text-lg font-bold text-slate-800">
                        Click to upload photos
                    </h3>

                    <p class="mt-1 text-sm text-slate-500">
                        or drag and drop
                    </p>

                    <p class="mt-3 text-xs text-slate-400">
                        Max 10 photos • JPG/PNG • Max 5MB each
                    </p>

                    <button type="button" id="browseBtn"
                        class="mt-5 rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700">

                        Browse Photos

                    </button>

                </div>


                <!-- PREVIEW -->

                <div id="photoPreview" class="mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
                </div>


                <button type="button" id="addPhotoBtn"
                    class="mt-5 rounded-xl border border-indigo-200 px-4 py-2.5 text-sm font-semibold text-indigo-600 transition hover:bg-indigo-50">

                    + Add More Photos

                </button>

            </section>


            <!-- ================= FACILITIES ================= -->

            <section class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7">

                <div class="mb-7 flex items-start gap-4">

                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-xl">
                        🛏️
                    </div>

                    <div>

                        <h2 class="text-xl font-bold text-slate-900">
                            Room & Facilities
                        </h2>

                        <p class="mt-1 text-sm text-slate-500">
                            Select everything available in your room.
                        </p>

                    </div>

                </div>


                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">


                    <!-- FACILITY -->

                    <label
                        class="group flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-300 hover:bg-indigo-50">

                        <input type="checkbox" name="facilities" value="Wi-Fi" class="h-4 w-4 accent-indigo-600">

                        <span class="text-sm font-medium text-slate-700">
                            📶 Wi-Fi
                        </span>

                    </label>


                    <label
                        class="group flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-300 hover:bg-indigo-50">

                        <input type="checkbox" name="facilities" value="Power Backup" class="h-4 w-4 accent-indigo-600">

                        <span class="text-sm font-medium text-slate-700">
                            🔋 Power Backup
                        </span>

                    </label>


                    <label
                        class="group flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-300 hover:bg-indigo-50">

                        <input type="checkbox" name="facilities" value="Attached Bathroom"
                            class="h-4 w-4 accent-indigo-600">

                        <span class="text-sm font-medium text-slate-700">
                            🚿 Attached Bathroom
                        </span>

                    </label>


                    <label
                        class="group flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-300 hover:bg-indigo-50">

                        <input type="checkbox" name="facilities" value="Water Supply" class="h-4 w-4 accent-indigo-600">

                        <span class="text-sm font-medium text-slate-700">
                            💧 Water Supply
                        </span>

                    </label>


                    <label
                        class="group flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-300 hover:bg-indigo-50">

                        <input type="checkbox" name="facilities" value="Study Table" class="h-4 w-4 accent-indigo-600">

                        <span class="text-sm font-medium text-slate-700">
                            📚 Study Table
                        </span>

                    </label>


                    <label
                        class="group flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-300 hover:bg-indigo-50">

                        <input type="checkbox" name="facilities" value="Wardrobe" class="h-4 w-4 accent-indigo-600">

                        <span class="text-sm font-medium text-slate-700">
                            👕 Wardrobe
                        </span>

                    </label>


                    <label
                        class="group flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-300 hover:bg-indigo-50">

                        <input type="checkbox" name="facilities" value="Bed" class="h-4 w-4 accent-indigo-600">

                        <span class="text-sm font-medium text-slate-700">
                            🛏️ Bed
                        </span>

                    </label>


                    <label
                        class="group flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-300 hover:bg-indigo-50">

                        <input type="checkbox" name="facilities" value="Washing Machine"
                            class="h-4 w-4 accent-indigo-600">

                        <span class="text-sm font-medium text-slate-700">
                            🧺 Washing Machine
                        </span>

                    </label>


                    <label
                        class="group flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-300 hover:bg-indigo-50">

                        <input type="checkbox" name="facilities" value="Parking" class="h-4 w-4 accent-indigo-600">

                        <span class="text-sm font-medium text-slate-700">
                            🅿️ Parking
                        </span>

                    </label>


                    <label
                        class="group flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-300 hover:bg-indigo-50">

                        <input type="checkbox" name="facilities" value="CCTV Security"
                            class="h-4 w-4 accent-indigo-600">

                        <span class="text-sm font-medium text-slate-700">
                            📹 CCTV Security
                        </span>

                    </label>


                    <label
                        class="group flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-300 hover:bg-indigo-50">

                        <input type="checkbox" name="facilities" value="Kitchen Access"
                            class="h-4 w-4 accent-indigo-600">

                        <span class="text-sm font-medium text-slate-700">
                            🍳 Kitchen Access
                        </span>

                    </label>

                </div>


                <!-- OTHER -->

                <div class="mt-5">

                    <label for="otherFacility" class="mb-2 block text-sm font-semibold text-slate-700">

                        Other Facility

                    </label>

                    <input type="text" id="otherFacility" name="otherFacility"
                        placeholder="e.g. Balcony, AC, Refrigerator..."
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">

                </div>

            </section>


            <!-- ================= HOUSE RULES ================= -->

            <section class="mb-6 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-7">

                <div class="mb-7 flex items-start gap-4">

                    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-xl">
                        📜
                    </div>

                    <div>

                        <h2 class="text-xl font-bold text-slate-900">
                            House Rules
                        </h2>

                        <p class="mt-1 text-sm text-slate-500">
                            Tell tenants about your house rules.
                        </p>

                    </div>

                </div>


                <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">


                    <label
                        class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-300 hover:bg-indigo-50">

                        <input type="checkbox" name="rules" value="No Smoking" class="h-4 w-4 accent-indigo-600">

                        <span class="text-sm font-medium text-slate-700">
                            🚭 No Smoking
                        </span>

                    </label>


                    <label
                        class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-300 hover:bg-indigo-50">

                        <input type="checkbox" name="rules" value="No Pets" class="h-4 w-4 accent-indigo-600">

                        <span class="text-sm font-medium text-slate-700">
                            🐕 No Pets
                        </span>

                    </label>


                    <label
                        class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-300 hover:bg-indigo-50">

                        <input type="checkbox" name="rules" value="Visitors Not Allowed"
                            class="h-4 w-4 accent-indigo-600">

                        <span class="text-sm font-medium text-slate-700">
                            🚫 Visitors Not Allowed
                        </span>

                    </label>


                    <label
                        class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-300 hover:bg-indigo-50">

                        <input type="checkbox" name="rules" value="Maintain Cleanliness"
                            class="h-4 w-4 accent-indigo-600">

                        <span class="text-sm font-medium text-slate-700">
                            🧹 Maintain Cleanliness
                        </span>

                    </label>


                    <label
                        class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 p-4 transition hover:border-indigo-300 hover:bg-indigo-50">

                        <input type="checkbox" name="rules" value="No Loud Music" class="h-4 w-4 accent-indigo-600">

                        <span class="text-sm font-medium text-slate-700">
                            🔇 No Loud Music
                        </span>

                    </label>

                </div>


                <div class="mt-5">

                    <label for="otherRule" class="mb-2 block text-sm font-semibold text-slate-700">

                        Other Rule

                    </label>

                    <input type="text" id="otherRule" name="otherRule" placeholder="e.g. Gate closes at 10 PM..."
                        class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100">

                </div>

            </section>


            <!-- ================= TIPS ================= -->

            <section class="mb-6 rounded-2xl border border-amber-200 bg-amber-50 p-5 sm:p-6">

                <h3 class="flex items-center gap-2 text-lg font-bold text-amber-900">
                    💡 Tips to Get More Bookings
                </h3>

                <ul class="mt-4 space-y-3 text-sm text-amber-800">

                    <li class="flex gap-2">
                        <span>✓</span>
                        Upload clear and bright photos
                    </li>

                    <li class="flex gap-2">
                        <span>✓</span>
                        Provide accurate information
                    </li>

                    <li class="flex gap-2">
                        <span>✓</span>
                        Mention nearby coaching/colleges
                    </li>

                    <li class="flex gap-2">
                        <span>✓</span>
                        Respond quickly to inquiries
                    </li>

                </ul>

            </section>


            <!-- ================= SUBMISSION ================= -->

            <section class="mb-6 flex gap-4 rounded-2xl border border-emerald-200 bg-emerald-50 p-5 sm:p-6">

                <div
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-emerald-500 font-bold text-white">
                    ✓
                </div>

                <div>

                    <h3 class="font-bold text-emerald-900">
                        After Submission
                    </h3>

                    <p class="mt-1 text-sm leading-6 text-emerald-800">
                        Your listing will be reviewed by our team.
                        Once approved, it will be live on our platform.
                        Usually takes 24 hours.
                    </p>

                </div>

            </section>


            <!-- ================= BUTTONS ================= -->

            <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">

                <button type="button" onclick="history.back()"
                    class="rounded-xl border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-700 transition hover:bg-slate-50">

                    Cancel

                </button>

                <button type="submit"
                    class="rounded-xl bg-indigo-600 px-7 py-3 font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-4 focus:ring-indigo-200">

                    Submit Room Listing →

                </button>

            </div>

        </form>


        <!-- ================= HELP ================= -->

        <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm">

            <h3 class="text-lg font-bold text-slate-900">
                Need Help?
            </h3>

            <p class="mt-1 text-sm text-slate-500">
                Our support team is here to help you.
            </p>

            <button type="button"
                class="mt-4 rounded-xl border border-indigo-200 px-5 py-2.5 text-sm font-semibold text-indigo-600 transition hover:bg-indigo-50">

                Contact Support

            </button>

        </div>

    </main>


    <!-- ================= JAVASCRIPT ================= -->

    <script>

        /* ================= MOBILE MENU ================= */

        const menuBtn = document.getElementById("menuBtn");
        const mobileMenu = document.getElementById("mobileMenu");

        menuBtn.addEventListener("click", function () {

            mobileMenu.classList.toggle("hidden");

        });


        /* ================= CHARACTER COUNT ================= */

        const description =
            document.getElementById("description");

        const charCount =
            document.getElementById("charCount");

        description.addEventListener("input", function () {

            charCount.textContent =
                this.value.length + "/500";

        });


        /* ================= PHOTO UPLOAD ================= */

        const uploadArea =
            document.getElementById("uploadArea");

        const photosInput =
            document.getElementById("photos");

        const browseBtn =
            document.getElementById("browseBtn");

        const addPhotoBtn =
            document.getElementById("addPhotoBtn");

        const photoPreview =
            document.getElementById("photoPreview");


        let selectedFiles = [];


        browseBtn.addEventListener("click", function (event) {

            event.stopPropagation();

            photosInput.click();

        });


        addPhotoBtn.addEventListener("click", function () {

            photosInput.click();

        });


        uploadArea.addEventListener("click", function () {

            photosInput.click();

        });


        /* DRAG OVER */

        uploadArea.addEventListener("dragover", function (event) {

            event.preventDefault();

            uploadArea.classList.add(
                "border-indigo-500",
                "bg-indigo-100"
            );

        });


        /* DRAG LEAVE */

        uploadArea.addEventListener("dragleave", function () {

            uploadArea.classList.remove(
                "border-indigo-500",
                "bg-indigo-100"
            );

        });


        /* DROP */

        uploadArea.addEventListener("drop", function (event) {

            event.preventDefault();

            uploadArea.classList.remove(
                "border-indigo-500",
                "bg-indigo-100"
            );

            handleFiles(event.dataTransfer.files);

        });


        /* FILE CHANGE */

        photosInput.addEventListener("change", function () {

            handleFiles(this.files);

        });


        function handleFiles(files) {

            const incomingFiles =
                Array.from(files);


            for (const file of incomingFiles) {

                if (selectedFiles.length >= 10) {

                    alert("Maximum 10 photos are allowed.");

                    break;

                }


                if (
                    file.type !== "image/jpeg" &&
                    file.type !== "image/png"
                ) {

                    alert(
                        file.name +
                        " is not a JPG or PNG image."
                    );

                    continue;

                }


                if (file.size > 5 * 1024 * 1024) {

                    alert(
                        file.name +
                        " is larger than 5MB."
                    );

                    continue;

                }


                selectedFiles.push(file);

            }


            renderPreviews();

            updateInputFiles();

        }


        function renderPreviews() {

            photoPreview.innerHTML = "";


            selectedFiles.forEach((file, index) => {

                const reader = new FileReader();


                reader.onload = function (event) {

                    const preview =
                        document.createElement("div");


                    preview.className =
                        "relative overflow-hidden rounded-xl border border-slate-200 bg-white";


                    preview.innerHTML = `

                        <img
                            src="${event.target.result}"
                            alt="Room photo"
                            class="h-40 w-full object-cover"
                        >

                        <button
                            type="button"
                            onclick="removePhoto(${index})"
                            class="absolute right-2 top-2 flex h-8 w-8 items-center justify-center rounded-full bg-black/70 text-lg text-white hover:bg-black"
                        >
                            ×
                        </button>

                        ${index === 0
                            ?
                            '<span class="absolute bottom-2 left-2 rounded-lg bg-indigo-600 px-2 py-1 text-xs font-semibold text-white">Main Photo</span>'
                            :
                            ''
                        }

                    `;


                    photoPreview.appendChild(preview);

                };


                reader.readAsDataURL(file);

            });

        }


        function removePhoto(index) {

            selectedFiles.splice(index, 1);

            renderPreviews();

            updateInputFiles();

        }


        function updateInputFiles() {

            const dataTransfer =
                new DataTransfer();


            selectedFiles.forEach(file => {

                dataTransfer.items.add(file);

            });


            photosInput.files =
                dataTransfer.files;

        }


        /* ================= DATE ================= */

        const availableFrom =
            document.getElementById("availableFrom");


        const today =
            new Date()
                .toISOString()
                .split("T")[0];


        availableFrom.min = today;

    </script>

</body>

</html>