<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sign Up - ROOM ON RENT</title>

    <!-- Tailwind CSS -->
    <link rel="stylesheet" href="/css/output.css">
</head>

<body>
    <%- include("../partials/navbar.ejs") %>

    <div class="min-h-screen bg-gray-50 flex items-center justify-center px-4 py-10">

        <div class="w-full max-w-lg">

            <!-- Logo / Brand -->
            <div class="text-center mb-8">

                <a href="/" class="inline-block">

                    <h1 class="text-3xl sm:text-4xl font-extrabold text-indigo-600">
                        ROOM ON RENT
                    </h1>

                </a>

                <p class="mt-2 text-gray-500 text-sm sm:text-base">
                    Find your perfect room & stay comfortably
                </p>

            </div>


            <!-- Signup Card -->
            <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-6 sm:p-8">

                <!-- Heading -->
                <div class="mb-6">

                    <h2 class="text-2xl font-bold text-gray-800">
                        Create Your Account ✨
                    </h2>

                    <p class="text-gray-500 text-sm mt-1">
                        Join ROOM ON RENT and find your perfect room
                    </p>

                </div>


                <!-- Signup Form -->
                <form action="/signup" method="POST" class="space-y-5">


                    <!-- Full Name -->
                    <div>

                        <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
                            Full Name
                        </label>

                        <input type="text" id="name" name="name" placeholder="Enter your full name" required
                            autocomplete="name" class="w-full px-4 py-3 rounded-xl border border-gray-300
                                   outline-none transition
                                   focus:border-indigo-500
                                   focus:ring-2 focus:ring-indigo-100">

                    </div>


                    <!-- Email + Mobile -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

                        <!-- Email -->
                        <div>

                            <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
                                Email Address
                            </label>

                            <input type="email" id="email" name="email" placeholder="you@example.com" required
                                autocomplete="email" class="w-full px-4 py-3 rounded-xl border border-gray-300
                                       outline-none transition
                                       focus:border-indigo-500
                                       focus:ring-2 focus:ring-indigo-100">

                        </div>


                        <!-- Mobile -->
                        <div>

                            <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
                                Mobile Number
                            </label>

                            <input type="tel" id="phone" name="phone" placeholder="10-digit mobile" pattern="[0-9]{10}"
                                required autocomplete="tel" class="w-full px-4 py-3 rounded-xl border border-gray-300
                                       outline-none transition
                                       focus:border-indigo-500
                                       focus:ring-2 focus:ring-indigo-100">

                        </div>

                    </div>


                    <!-- Account Type -->
                    <div>

                        <label for="role" class="block text-sm font-medium text-gray-700 mb-2">
                            I want to
                        </label>

                        <select id="role" name="role" required class="w-full px-4 py-3 rounded-xl border border-gray-300
                                   bg-white text-gray-700
                                   outline-none transition
                                   focus:border-indigo-500
                                   focus:ring-2 focus:ring-indigo-100">

                            <option value="" disabled selected>
                                Select account type
                            </option>

                            <option value="tenant">
                                Find a Room
                            </option>

                            <option value="owner">
                                Rent Out My Room
                            </option>

                        </select>

                    </div>


                    <!-- Password -->
                    <div>

                        <label for="password" class="block text-sm font-medium text-gray-700 mb-2">
                            Password
                        </label>

                        <input type="password" id="password" name="password" placeholder="Create a strong password"
                            minlength="6" required autocomplete="new-password" class="w-full px-4 py-3 rounded-xl border border-gray-300
                                   outline-none transition
                                   focus:border-indigo-500
                                   focus:ring-2 focus:ring-indigo-100">

                        <p class="text-xs text-gray-400 mt-1">
                            Password must be at least 6 characters.
                        </p>

                    </div>


                    <!-- Confirm Password -->
                    <div>

                        <label for="confirmPassword" class="block text-sm font-medium text-gray-700 mb-2">
                            Confirm Password
                        </label>

                        <input type="password" id="confirmPassword" name="confirmPassword"
                            placeholder="Re-enter your password" minlength="6" required autocomplete="new-password"
                            class="w-full px-4 py-3 rounded-xl border border-gray-300
                                   outline-none transition
                                   focus:border-indigo-500
                                   focus:ring-2 focus:ring-indigo-100">

                    </div>


                    <!-- Terms -->
                    <div class="flex items-start gap-3">

                        <input type="checkbox" id="terms" name="terms" required
                            class="mt-1 w-4 h-4 accent-green-600 cursor-pointer">

                        <label for="terms" class="text-sm text-gray-500 leading-5 cursor-pointer">

                            I agree to the
                            <a href="/terms" class="text-indigo-600 hover:text-indigo-700 font-medium">
                                Terms & Conditions
                            </a>
                            and
                            <a href="/privacy" class="text-indigo-600 hover:text-indigo-700 font-medium">
                                Privacy Policy
                            </a>.

                        </label>

                    </div>


                    <!-- Create Account Button -->
                    <button type="submit" class="w-full bg-indigo-600 hover:bg-indigo-700
                               text-white font-semibold
                               py-3 px-4 rounded-xl
                               transition duration-200
                               shadow-sm hover:shadow-md">

                        Create Account

                    </button>

                </form>


                <!-- Divider -->
                <div class="flex items-center gap-3 my-6">

                    <div class="h-px bg-gray-200 flex-1"></div>

                    <span class="text-sm text-gray-400">
                        OR
                    </span>

                    <div class="h-px bg-gray-200 flex-1"></div>

                </div>


                <!-- Google Signup -->
                <button type="button" class="w-full flex items-center justify-center gap-3
                           border border-gray-300
                           py-3 px-4 rounded-xl
                           text-gray-700 font-medium
                           hover:bg-gray-50 transition">

                    <span class="text-lg font-bold">
                        G
                    </span>

                    Continue with Google

                </button>


                <!-- Login -->
                <p class="text-center text-sm text-gray-500 mt-6">

                    Already have an account?

                    <a href="/login" class="text-indigo-600 hover:text-indigo-700 font-semibold">

                        Login

                    </a>

                </p>

            </div>


            <!-- Footer -->
            <p class="text-center text-xs text-gray-400 mt-6">

                © <%= new Date().getFullYear() %> ROOM ON RENT.
                    All rights reserved.

            </p>

        </div>

    </div>

</body>

</html>